export interface GraphNode {
  id: string;
  label: string;
  type: "service" | "tech" | "concept";
  memoryCount: number;
}

export interface GraphEdge {
  source: string;
  target: string;
  type: "mentions" | "depends-on" | "stores-in";
  weight: number;
}

export interface MemoryGraphProps {
  nodes: GraphNode[];
  edges: GraphEdge[];
  onEntityClick?: (entityId: string) => void;
  loading?: boolean;
}

